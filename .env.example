# Groq API Key — the only AI provider used by this app (strategy analysis,
# blueprint planning, and full-stack code generation all run on Groq / GPT-OSS 120B)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (optional last-resort fallback, only used if GROQ_API_KEY is missing)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Credentials (Optional - App falls back to local storage if omitted)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required to verify user sessions server-side (JWT signature verification)
# and to read/write project data past Row Level Security. Without this key,
# every authenticated API route will reject requests. Find it in
# Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI response cache (public.ai_cache). Identical inputs to analyze / blueprint /
# file-directory / build reuse the stored result instead of re-calling Groq.
# On by default when the service-role key is set. Optional overrides:
#   AI_CACHE=off            disable entirely
#   AI_CACHE_TTL_HOURS=168  how long a cached entry stays valid (default 168 = 7 days)
# AI_CACHE=off
# AI_CACHE_TTL_HOURS=168
